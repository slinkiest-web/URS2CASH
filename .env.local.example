# =============================================================================
# Urs2Cash — environment variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local.
# =============================================================================
#
# Variable naming convention (PRD §12.4):
#   NEXT_PUBLIC_*  → client-safe: visible in the browser bundle.
#   (no prefix)    → server-only: never accessible to the client.
#
# HARD RULE (PRD §12.3 & §12.4):
#   SERVICE_ROLE_KEY, PAYSTACK_SECRET_KEY, PAYSTACK_WEBHOOK_SECRET,
#   and RESEND_API_KEY must NEVER be prefixed NEXT_PUBLIC_.
#   Leaking any of these to the client bundle is a critical security failure.
# =============================================================================

# -----------------------------------------------------------------------------
# CLIENT-SAFE (NEXT_PUBLIC_*) — visible in the browser
# -----------------------------------------------------------------------------

# Supabase project URL — same value for browser and server
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon (public) key — safe to expose, RLS enforced
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Paystack public key — used client-side to initialise the Paystack popup
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# PostHog project API key and host
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Application base URL (used for OG tags, email links, webhook registration)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Support contact address — PRD §9.1/§5.2: the support route is a plain
# contact link in MVP, never in-app ticketing and never seller contact.
NEXT_PUBLIC_SUPPORT_EMAIL=support@urs2cash.com

# -----------------------------------------------------------------------------
# SERVER-ONLY — never prefix with NEXT_PUBLIC_, never import in client code
# -----------------------------------------------------------------------------

# Supabase service role key — bypasses RLS; server actions and cron only
SUPABASE_SERVICE_ROLE_KEY=

# Paystack secret key — used server-side for payment initialisation and refunds
PAYSTACK_SECRET_KEY=

# Paystack webhook signing secret — used to verify inbound webhook payloads
PAYSTACK_WEBHOOK_SECRET=

# Resend API key — used server-side for transactional email
RESEND_API_KEY=

# Secret shared with Vercel Cron — routes verify this header before executing
CRON_SECRET=
