# =============================================================================
# Urs2Cash — environment variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local.
# =============================================================================
#
# Variable naming convention (PRD §12.4):
#   NEXT_PUBLIC_*  → client-safe: visible in the browser bundle.
#   (no prefix)    → server-only: never accessible to the client.
#
# HARD RULE (PRD §12.3 & §12.4):
#   SERVICE_ROLE_KEY, PAYSTACK_SECRET_KEY, and RESEND_API_KEY must NEVER be
#   prefixed NEXT_PUBLIC_. Leaking any of these to the client bundle is a
#   critical security failure.
# =============================================================================

# -----------------------------------------------------------------------------
# CLIENT-SAFE (NEXT_PUBLIC_*) — visible in the browser
# -----------------------------------------------------------------------------

# Supabase project URL — same value for browser and server
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon (public) key — safe to expose, RLS enforced
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Paystack public key — used client-side to initialise the Paystack popup
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# PostHog project API key and host
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Application base URL (used for OG tags, email links, webhook registration)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Support contact address — PRD §9.1/§5.2: the support route is a plain
# contact link in MVP, never in-app ticketing and never seller contact.
NEXT_PUBLIC_SUPPORT_EMAIL=support@urs2cash.com

# -----------------------------------------------------------------------------
# SERVER-ONLY — never prefix with NEXT_PUBLIC_, never import in client code
# -----------------------------------------------------------------------------

# Supabase service role key — bypasses RLS; server actions and cron only
SUPABASE_SERVICE_ROLE_KEY=

# Paystack secret key — used server-side for payment initialisation and
# refunds, and ALSO as the HMAC-SHA512 key for verifying the
# x-paystack-signature header on inbound webhooks (Prompt 14). Paystack has
# no separate webhook-signing secret the way some other providers do — the
# account's own secret key is the signing key for both purposes. There is
# deliberately no PAYSTACK_WEBHOOK_SECRET variable here; do not add one.
PAYSTACK_SECRET_KEY=

# Resend API key — used server-side for transactional email
RESEND_API_KEY=

# "From" address for transactional email (order/dispute/payout/listing
# notifications). Must be on a domain verified with Resend.
EMAIL_FROM="Urs2Cash <notifications@urs2cash.com>"

# Internal operational alert address — PRD §10 Epic D5 AC6: admin is
# notified when a dispute is raised. Distinct from NEXT_PUBLIC_SUPPORT_EMAIL
# above (that's the public buyer-facing contact link, §9.1); this is
# internal-only and never shown to a buyer or seller.
ADMIN_ALERT_EMAIL=

# Secret shared with Vercel Cron — routes verify this header before executing
CRON_SECRET=
